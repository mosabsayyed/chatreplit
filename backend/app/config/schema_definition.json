{
  "ent_entities": {
    "primary_key": ["id", "year"],
    "columns": ["id", "year", "quarter", "name", "level"]
  },
  "ent_projects": {
    "primary_key": ["id", "year"],
    "columns": ["id", "year", "quarter", "name", "status", "progress_percentage", "budget", "start_date", "end_date", "level"]
  },
  "ent_capabilities": {
    "primary_key": ["id", "year"],
    "columns": ["id", "year", "quarter", "level", "parent_id", "parent_year", "name", "maturity_level", "status"]
  },
  "ent_it_systems": {
    "primary_key": ["id", "year"],
    "columns": ["id", "year", "quarter", "name", "criticality", "level"]
  },
  "sec_objectives": {
    "primary_key": ["id", "year"],
    "columns": ["id", "year", "quarter", "level", "parent_id", "parent_year", "name"]
  },
  "sec_risks": {
    "primary_key": ["id", "year"],
    "columns": ["id", "year", "quarter", "name", "category", "severity", "status", "level"]
  },
  "str_strategies": {
    "primary_key": ["id", "year"],
    "columns": ["id", "year", "quarter", "name", "level"]
  },
  "tac_tactics": {
    "primary_key": ["id", "year"],
    "columns": ["id", "year", "quarter", "name", "level"]
  },
  "jt_entity_projects": {
    "primary_key": ["id"],
    "foreign_keys": [
      {"entity_id": "ent_entities.id", "entity_year": "ent_entities.year"},
      {"project_id": "ent_projects.id", "project_year": "ent_projects.year"}
    ]
  },
  "jt_project_capabilities": {
    "primary_key": ["id"],
    "foreign_keys": [
      {"project_id": "ent_projects.id", "project_year": "ent_projects.year"},
      {"capability_id": "ent_capabilities.id", "capability_year": "ent_capabilities.year"}
    ]
  },
  "jt_project_it_systems": {
    "primary_key": ["id"],
    "foreign_keys": [
      {"project_id": "ent_projects.id", "project_year": "ent_projects.year"},
      {"it_system_id": "ent_it_systems.id", "it_system_year": "ent_it_systems.year"}
    ]
  },
  "jt_it_system_risks": {
    "primary_key": ["id"],
    "foreign_keys": [
      {"it_system_id": "ent_it_systems.id", "it_system_year": "ent_it_systems.year"},
      {"risk_id": "sec_risks.id", "risk_year": "sec_risks.year"}
    ]
  },
  "jt_capability_risks": {
    "primary_key": ["id"],
    "foreign_keys": [
      {"capability_id": "ent_capabilities.id", "capability_year": "ent_capabilities.year"},
      {"risk_id": "sec_risks.id", "risk_year": "sec_risks.year"}
    ]
  },
  "jt_strategy_tactics": {
    "primary_key": ["id"],
    "foreign_keys": [
      {"strategy_id": "str_strategies.id", "strategy_year": "str_strategies.year"},
      {"tactic_id": "tac_tactics.id", "tactic_year": "tac_tactics.year"}
    ]
  },
  "jt_tactic_projects": {
    "primary_key": ["id"],
    "foreign_keys": [
      {"tactic_id": "tac_tactics.id", "tactic_year": "tac_tactics.year"},
      {"project_id": "ent_projects.id", "project_year": "ent_projects.year"}
    ]
  }
}
